{
  "name": "youxi-games",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.20.0",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "build": "pnpm run typecheck && vite build",
    "build:game": "pnpm run typecheck && node scripts/build-game.mjs",
    "build:backpack:douyin": "pnpm run typecheck && node games/backpack-expedition-h5/douyin/build.mjs",
    "build:town:douyin": "pnpm run typecheck && node games/town-delivery-h5/douyin/build.mjs",
    "build:kitten:douyin": "pnpm run typecheck && node games/rule-kitten-h5/douyin/build.mjs",
    "test:kitten:canvas": "pnpm run build:kitten:douyin && node --test games/rule-kitten-h5/tests/*.browser.mjs",
    "test:town:canvas": "pnpm run build:town:douyin && node --test games/town-delivery-h5/tests/canvas.browser.mjs",
    "test:backpack:canvas": "pnpm run build:backpack:douyin && node --test games/backpack-expedition-h5/tests/canvas-migration.browser.mjs",
    "preview": "vite preview",
    "new:game": "node scripts/new-game.mjs",
    "test": "node --test scripts/tests/*.test.mjs games/*/tests/*.test.ts",
    "prepare": "husky",
    "ci:games": "node scripts/ci-games.mjs"
  },
  "dependencies": {
    "pixi.js": "^8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.90.0",
    "playwright": "1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": "oxlint"
  }
}
